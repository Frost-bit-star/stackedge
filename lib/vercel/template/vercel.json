{
  "version": 2,
  "fluid": true,
  "functions": {
    "api/gateway.js": {
      "maxDuration": 300
    }
  },
  "routes": [
    { "src": "/_health", "dest": "/api/gateway.js" },
    { "src": "/_verify", "dest": "/api/gateway.js" },
    { "src": "/_frpc", "dest": "/api/gateway.js" },
    { "src": "/(.*)", "dest": "/api/gateway.js" }
  ]
}
